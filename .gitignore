# ============================================================
# cloud-stream .gitignore
# 口径：只纳入「可重建」之外的源码/脚本/文档；构建产物、部署副本、
# 诊断原始数据、私钥一律不入库（体积大或敏感，可随时重新生成）。
# ============================================================

# ---- Rust 构建产物（含 crates/shell 这种独立子工程自己的 target/）----
target/
**/target/
**/*.pdb
**/*.rlib
**/*.rmeta
**/*.d
**/*.o

# ---- 日志（构建 / 运行 / 探针输出）----
/logs/
/build-*.log
/toolchain/*.log
/toolchain/*.txt

# ---- 部署与打包副本（由 dist / 部署流程生成）----
/toolchain/dist-test/
/toolchain/deploy143/
/toolchain/vendor-backup/

# ---- 大数据文件（JDK 压缩包等，本地自备）----
/toolchain/*.zip
/toolchain/*.7z
/toolchain/*.jar

# ---- 证书私钥（敏感，仅本地保留）----
# 注意：只忽略 toolchain/ 下的自签证书；vendor/hbb_common/tests/data/*.pem
# 是 RustDesk 上游的测试固件，被 include_bytes! 引用，必须入库。
/toolchain/*.pem
/toolchain/*.key
/toolchain/*.pfx
*.p12

# ---- 排查现场：整目录忽略 ----
# dump-triage/ 是抓帧、临时脚本、SSH 配置、日志的沙盒，产物全部可由
# --dump-frame / 重新跑一次得到，不属于源码。之前只写了 *.bmp/*.ivf，
# 于是 stream-server-148.log（64 KB 运行日志）在版本库里躺了半个月，
# 另外还有 20 多个未跟踪文件天天污染 git status。
# 已跟踪的 dump-triage/mcbak/launch-remote.ps1 不受影响，仍会正常显示改动。
/dump-triage/

# ---- 会话临时目录 ----
# .workbuddy/tmp/ 是智能体跑临时脚本、抓一次现场用的沙盒，内容和 dump-triage/
# 一样属于"重跑一次就有"，但天天在 git status 里出现会把真正的改动淹掉。
# memory/ 与 settings 不在此列：它们是项目记忆，要入库。
/.workbuddy/tmp/

# ---- 编辑器 / 系统 ----
Thumbs.db
.DS_Store
*.swp
*~
.idea/
.vscode/

# Python bytecode (toolchain/*.py 是本机诊断脚本)
__pycache__/
*.pyc

# 提交信息的临时落点（bash 里 heredoc 会被拦，只能先写文件再 `git commit -F`）
.git-commit-msg.tmp

# ---- 外部参考物 /temp/ ----
# temp/ 放的是"从外面拿进来对照用"的东西：几猫那份单文件 FPS 是 1:1 相对指针
# 契约的参考实现（docs/roadmap-future.md §1.2 就是围绕它写的），要入库。
# 同一目录里的 *.txt 是提交信息草稿、抓取片段之类的中间物，不进。
/temp/*.txt

# 部署产物：前端 dist 打包出来的 zip（由 toolchain/serve-file.ps1 投递给被控机）。
# 每次部署都重新生成，体积 1.2 MB，没有任何入库价值。
/temp/*.zip

# 跑 toolchain\build.ps1 -Task test 时把输出重定向到这里再筛（直接管道会被
# PowerShell 的编码搞坏）。纯中间物。
/temp/*.log
